[Unit]
Description=PortBridge Origin Client (原站端)
Documentation=https://github.com/beibing173/portbridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portbridge
Group=portbridge
WorkingDirectory=/opt/portbridge
ExecStart=/opt/portbridge/portbridge -c /opt/portbridge/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
LimitNOFILE=1048576
LimitNPROC=65535

# ---------- 安全加固 ----------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/portbridge/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
